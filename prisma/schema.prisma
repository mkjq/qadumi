// Prisma schema file for Qadoumi Educational Center
// Extended with Student Accounts, Gamification Points, and Interactive Quiz Engine

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  engineType      = "wasm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// EXISTING MODELS (DO NOT DROP OR MODIFY COLUMNS)
// ============================================

model Teacher {
  id          Int      @id @default(autoincrement())
  name        String
  subject     String
  grades      String   // comma-separated grades
  phone       String?
  whatsapp    String?
  facebook    String?
  instagram   String?
  bio         String?
  image       String?
  imagePosition String? @default("object-center")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CenterInfo {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Video {
  id          Int      @id @default(autoincrement())
  title       String
  url         String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Admin {
  id           Int      @id @default(autoincrement())
  name         String   @default("مدير النظام")
  username     String   @unique
  passwordHash String
  role         String   @default("ADMIN") // SUPER_ADMIN or ADMIN
  permissions  String   @default("ALL") // Comma separated: TEACHERS,MATERIALS,MESSAGES,REVIEWS,SETTINGS
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Review {
  id         Int      @id @default(autoincrement())
  name       String
  userType   String   @default("طالب")
  content    String
  rating     Int      @default(5)
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Material {
  id              Int      @id @default(autoincrement())
  title           String
  subject         String
  grade           String
  branch          String?  // e.g., 'أكاديمي', 'مهني / BTEC', 'مشترك'
  teacherName     String
  googleDriveLink String
  coverImage      String?
  downloads       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model CourseCard {
  id          Int      @id @default(autoincrement())
  title       String
  subject     String
  grade       String
  teacherName String
  price       Float
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  orders      Order[]
}

model Order {
  id            Int        @id @default(autoincrement())
  customerName  String
  phone         String
  address       String?
  courseCardId  Int
  courseCard    CourseCard @relation(fields: [courseCardId], references: [id])
  paymentMethod String     // CLIQ, ZAIN_CASH, DELIVERY
  receiptUrl    String?
  status        String     @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt     DateTime   @default(now())
}

// ============================================
// NEW MODELS: Student Accounts & Gamification (R2)
// ============================================

model Student {
  id           Int        @id @default(autoincrement())
  name         String
  username     String     @unique
  email        String?    @unique
  phone        String?    @unique
  passwordHash String
  grade        String     // e.g. "توجيهي علمي", "أول ثانوي"
  points       Int        @default(0)
  level        String     @default("مبتدئ") // "مبتدئ", "متقدم", "بطل القدومي", "أسطورة القدومي"
  avatar       String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  enrolledGrades    EnrolledGrade[]
  pointTransactions PointTransaction[]
  quizSubmissions   QuizSubmission[]
  rewardRedemptions RewardRedemption[]
}

// General User model compatibility (for acceptance criteria: "new user, points, and quiz models")
model User {
  id           Int        @id @default(autoincrement())
  name         String
  username     String     @unique
  email        String?    @unique
  phone        String?    @unique
  passwordHash String
  role         String     @default("STUDENT")
  grade        String?
  points       Int        @default(0)
  avatar       String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model EnrolledGrade {
  id         Int      @id @default(autoincrement())
  studentId  Int
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grade      String
  subject    String?
  enrolledAt DateTime @default(now())
}

model PointTransaction {
  id          Int      @id @default(autoincrement())
  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount      Int      // Positive for earned, negative for redeemed
  type        String   // QUIZ_REWARD, DAILY_LOGIN, REWARD_REDEMPTION, WELCOME_BONUS
  description String
  createdAt   DateTime @default(now())
}

model Reward {
  id          Int                @id @default(autoincrement())
  title       String
  description String?
  pointsCost  Int
  icon        String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  redemptions RewardRedemption[]
}

model RewardRedemption {
  id          Int      @id @default(autoincrement())
  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rewardId    Int
  reward      Reward   @relation(fields: [rewardId], references: [id])
  pointsSpent Int
  status      String   @default("COMPLETED")
  createdAt   DateTime @default(now())
}

// ============================================
// NEW MODELS: Interactive Quiz Engine (R3)
// ============================================

model Quiz {
  id               Int            @id @default(autoincrement())
  title            String
  description      String?
  subject          String
  grade            String
  durationMinutes  Int            @default(15)
  pointsPerCorrect Int            @default(10) // Points awarded per correct answer
  bonusPoints      Int            @default(20) // Bonus points for completing/passing
  passingScore     Int            @default(60) // Passing percentage (0-100)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  questions        QuizQuestion[]
  submissions      QuizSubmission[]
}

model QuizQuestion {
  id          Int          @id @default(autoincrement())
  quizId      Int
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question    String
  order       Int          @default(0)
  points      Int          @default(10)
  explanation String?
  options     QuizOption[]
}

model QuizOption {
  id         Int          @id @default(autoincrement())
  questionId Int
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean      @default(false)
  order      Int          @default(0)
}

model QuizSubmission {
  id             Int      @id @default(autoincrement())
  quizId         Int
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId      Int
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score          Int      // percentage score (0-100)
  totalQuestions Int
  correctAnswers Int
  pointsEarned   Int      // gamification points awarded
  answersJson    String?  // serialized choices
  completedAt    DateTime @default(now())
}